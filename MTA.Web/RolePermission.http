@baseUrl = http://localhost:5000/api/RolePermission
@authToken = your_jwt_token_here

### ========================================
### RolePermission CRUD Operations
### ========================================

# Get all role permissions with pagination
GET {{baseUrl}}?page=1&pageSize=10
Authorization: Bearer {{authToken}}

# Get all role permissions filtered by role ID
GET {{baseUrl}}?page=1&pageSize=20
Authorization: Bearer {{authToken}}

# Get all role permissions filtered by permission ID
GET {{baseUrl}}?page=1&pageSize=20
Authorization: Bearer {{authToken}}

# Get specific role permission by ID
GET {{baseUrl}}/1
Authorization: Bearer {{authToken}}

# Create new role permission
POST {{baseUrl}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "roleId": 1,
  "permissionId": 3
}

# Update existing role permission
PUT {{baseUrl}}/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "roleId": 1,
  "permissionId": 4
}

# Delete role permission
DELETE {{baseUrl}}/1
Authorization: Bearer {{authToken}}

### ========================================
### RolePermission Queries
### ========================================

# Get role permissions by role ID
GET {{baseUrl}}/role/1
Authorization: Bearer {{authToken}}

# Get role permissions by permission ID
GET {{baseUrl}}/permission/2
Authorization: Bearer {{authToken}}

# Check if role has specific permission
GET {{baseUrl}}/check?roleId=1&permissionId=3
Authorization: Bearer {{authToken}}

### ========================================
### RolePermission Management Operations
### ========================================

# Assign permission to role
POST {{baseUrl}}/assign?roleId=2&permissionId=5
Authorization: Bearer {{authToken}}

# Remove permission from role
DELETE {{baseUrl}}/remove?roleId=2&permissionId=5
Authorization: Bearer {{authToken}}

# Bulk assign permissions to role
POST {{baseUrl}}/bulk-assign?roleId=3
Authorization: Bearer {{authToken}}
Content-Type: application/json

[1, 2, 3, 4]

# Bulk remove permissions from role
DELETE {{baseUrl}}/bulk-remove?roleId=3
Authorization: Bearer {{authToken}}
Content-Type: application/json

[1, 2]

### ========================================
### RolePermission Statistics and Reports
### ========================================

# Get role permission statistics
GET {{baseUrl}}/statistics
Authorization: Bearer {{authToken}}

### ========================================
### Error Testing
### ========================================

# Test with invalid role ID
GET {{baseUrl}}/role/999
Authorization: Bearer {{authToken}}

# Test with invalid permission ID
GET {{baseUrl}}/permission/999
Authorization: Bearer {{authToken}}

# Test creating duplicate role permission
POST {{baseUrl}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "roleId": 1,
  "permissionId": 3
}

# Test updating non-existent role permission
PUT {{baseUrl}}/999
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "roleId": 1,
  "permissionId": 3
}

# Test deleting non-existent role permission
DELETE {{baseUrl}}/999
Authorization: Bearer {{authToken}}

# Test bulk assign with empty permission list
POST {{baseUrl}}/bulk-assign?roleId=3
Authorization: Bearer {{authToken}}
Content-Type: application/json

[]

# Test without authorization
GET {{baseUrl}}
