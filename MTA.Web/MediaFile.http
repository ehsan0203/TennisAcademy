### MediaFile API Tests
### This file contains HTTP requests for testing the MediaFile API endpoints

@baseUrl = https://localhost:7001
@authToken = {{auth.response.body.token}}

### Authentication (if needed)
# @name auth
# POST {{baseUrl}}/api/auth/login
# Content-Type: application/json
# 
# {
#   "email": "admin@example.com",
#   "password": "Admin123!"
# }

### Get All Media Files
GET {{baseUrl}}/api/mediafile?page=1&pageSize=10
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get All Media Files with Filters
GET {{baseUrl}}/api/mediafile?page=1&pageSize=10&searchTerm=video&typeId=1&lessonId=1&messageId=1
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media File by ID
GET {{baseUrl}}/api/mediafile/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Create New Media File
POST {{baseUrl}}/api/mediafile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Tennis Lesson Video",
  "url": "https://example.com/videos/tennis-lesson.mp4",
  "typeId": 1,
  "lessonId": 1,
  "messageId": null
}

### Update Media File
PUT {{baseUrl}}/api/mediafile/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Updated Tennis Lesson Video",
  "url": "https://example.com/videos/updated-tennis-lesson.mp4",
  "typeId": 1,
  "lessonId": 1,
  "messageId": null
}

### Delete Media File
DELETE {{baseUrl}}/api/mediafile/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Update Media File Type
PATCH {{baseUrl}}/api/mediafile/1/type
Authorization: Bearer {{authToken}}
Content-Type: application/json

2

### Update Media File URL
PATCH {{baseUrl}}/api/mediafile/1/url
Authorization: Bearer {{authToken}}
Content-Type: application/json

"https://example.com/videos/new-url.mp4"

### Get Media Files by Type ID
GET {{baseUrl}}/api/mediafile/type/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media Files by Lesson ID
GET {{baseUrl}}/api/mediafile/lesson/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media Files by Message ID
GET {{baseUrl}}/api/mediafile/message/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media Files by Extension
GET {{baseUrl}}/api/mediafile/extension/.mp4
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media Files by Date Range
GET {{baseUrl}}/api/mediafile/date-range?startDate=2024-01-01&endDate=2024-12-31
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media Files by File Size Range
GET {{baseUrl}}/api/mediafile/size-range?minSize=1000000&maxSize=10000000
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Get Media File Statistics
GET {{baseUrl}}/api/mediafile/statistics
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Test Error Cases

### Get Non-existent Media File
GET {{baseUrl}}/api/mediafile/999
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Update Non-existent Media File
PUT {{baseUrl}}/api/mediafile/999
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "This file doesn't exist",
  "url": "https://example.com/nonexistent.mp4",
  "typeId": 1,
  "lessonId": null,
  "messageId": null
}

### Delete Non-existent Media File
DELETE {{baseUrl}}/api/mediafile/999
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Update Type of Non-existent Media File
PATCH {{baseUrl}}/api/mediafile/999/type
Authorization: Bearer {{authToken}}
Content-Type: application/json

1

### Update URL of Non-existent Media File
PATCH {{baseUrl}}/api/mediafile/999/url
Authorization: Bearer {{authToken}}
Content-Type: application/json

"https://example.com/new-url.mp4"

### Invalid Date Range
GET {{baseUrl}}/api/mediafile/date-range?startDate=2024-12-31&endDate=2024-01-01
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Invalid Size Range
GET {{baseUrl}}/api/mediafile/size-range?minSize=10000000&maxSize=1000000
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Create Media File with Invalid Data
POST {{baseUrl}}/api/mediafile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "",
  "url": "",
  "typeId": -1,
  "lessonId": -1,
  "messageId": -1
}

### Update Media File Type with Invalid Data
PATCH {{baseUrl}}/api/mediafile/1/type
Authorization: Bearer {{authToken}}
Content-Type: application/json

-1

### Update Media File URL with Empty String
PATCH {{baseUrl}}/api/mediafile/1/url
Authorization: Bearer {{authToken}}
Content-Type: application/json

""

### Test Different Media File Types

### Create Video File
POST {{baseUrl}}/api/mediafile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Tennis Serve Tutorial",
  "url": "https://example.com/videos/serve-tutorial.mp4",
  "typeId": 1,
  "lessonId": 1,
  "messageId": null
}

### Create Audio File
POST {{baseUrl}}/api/mediafile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Tennis Commentary",
  "url": "https://example.com/audio/commentary.mp3",
  "typeId": 2,
  "lessonId": null,
  "messageId": 1
}

### Create Document File
POST {{baseUrl}}/api/mediafile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Tennis Rules PDF",
  "url": "https://example.com/documents/rules.pdf",
  "typeId": 3,
  "lessonId": 1,
  "messageId": null
}

### Create Image File
POST {{baseUrl}}/api/mediafile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Tennis Court Layout",
  "url": "https://example.com/images/court-layout.jpg",
  "typeId": 4,
  "lessonId": 1,
  "messageId": null
}
